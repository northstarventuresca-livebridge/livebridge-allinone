{
  "name": "livebridge-vocabulary-preview",
  "main": "./worker.js",
  "compatibility_date": "2026-08-29",

  "durable_objects": {
    "bindings": [
      {
        "name": "LIVEBRIDGE_ROOMS",
        "class_name": "LiveBridgeRoom"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "LiveBridgeRoom"
      ]
    }
  ],

  "d1_databases": [
    {
      "binding": "TRANSLATIONS_DB",
      "database_name": "livebridge-vocabulary-qa",
      "database_id": "9661ce9b-b95e-4916-a33e-833d80da70b8"
    }
  ]
}
